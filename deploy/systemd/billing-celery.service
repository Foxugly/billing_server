[Unit]
Description=Foxugly Billing — Celery worker (livraison des droits)
After=network.target billing-env-fetch.service redis-server.service postgresql.service
Requires=billing-env-fetch.service

[Service]
User=django
Group=www-data
UMask=0027
WorkingDirectory=/var/www/django_websites/billing_server
EnvironmentFile=/run/billing/.env
# --pool=solo: the worker runs tasks itself, no child process. Rare, short tasks (webhook flush
# every 5 min with an HTTP timeout, daily reconcile): two prefork children cost ~200 MB on a RAM-
# bound box (OPERATIONS.md §3.22).
ExecStart=/var/www/django_websites/billing_server/.venv/bin/celery -A config worker -l info --pool=solo
# Hardening (OPERATIONS.md §3.22): no privilege escalation, private /tmp, read-only
# system (/usr, /boot, /etc). Never ProtectSystem=strict: /var/www (media, beat schedule)
# must stay writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
