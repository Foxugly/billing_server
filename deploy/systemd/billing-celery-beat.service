[Unit]
Description=Foxugly Billing — Celery beat (reprises et réconciliation)
After=network.target billing-env-fetch.service redis-server.service billing-celery.service
Requires=billing-env-fetch.service

[Service]
User=django
Group=www-data
UMask=0027
WorkingDirectory=/var/www/django_websites/billing_server
EnvironmentFile=/run/billing/.env
# /run/billing appartient à root (750 root:www-data) : django peut le traverser
# mais PAS y écrire — c'est le modèle §3.5, et beat doit écrire son fichier de
# planification. systemd crée donc un répertoire dédié, possédé par le service.
# Il est recréé à chaque démarrage : un schedule périmé est pire qu'absent.
RuntimeDirectory=billing-beat
RuntimeDirectoryMode=0750
ExecStart=/var/www/django_websites/billing_server/.venv/bin/celery -A config beat -l info \
    --schedule /run/billing-beat/schedule
Restart=always
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
